<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: green canvas + county logo -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_green</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_green</item>
        <item name="android:statusBarColor">@color/splash_green</item>
        <item name="android:navigationBarColor">@color/splash_green</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_green</item>
    </style>
</resources>
